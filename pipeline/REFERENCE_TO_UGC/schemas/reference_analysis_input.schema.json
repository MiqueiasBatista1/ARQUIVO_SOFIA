{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference_analysis_input.schema.json",
  "title": "ReferenceAnalysisPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_id",
    "source_context",
    "observations",
    "interpretations",
    "derived_translations",
    "reusable_patterns",
    "mechanisms",
    "non_copyable_elements",
    "remodeling_opportunities",
    "hypotheses_to_test"
  ],
  "properties": {
    "reference_id": { "type": "string", "minLength": 1 },
    "source_context": { "type": "object" },
    "observations": { "$ref": "#/$defs/records" },
    "interpretations": { "$ref": "#/$defs/records" },
    "derived_translations": { "$ref": "#/$defs/records" },
    "reusable_patterns": { "$ref": "#/$defs/records" },
    "mechanisms": { "$ref": "#/$defs/records" },
    "non_copyable_elements": { "$ref": "#/$defs/records" },
    "remodeling_opportunities": { "$ref": "#/$defs/records" },
    "hypotheses_to_test": { "$ref": "#/$defs/records" }
  },
  "$defs": {
    "records": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
