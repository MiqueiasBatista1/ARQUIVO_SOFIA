{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ugc_output.schema.json",
  "title": "RemodeledUGCConcept",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_id",
    "content_type",
    "ugc_template",
    "hook",
    "problem",
    "mechanism",
    "product",
    "core_benefit",
    "scene_structure",
    "dialogue",
    "actions",
    "camera",
    "lighting",
    "location",
    "emotion",
    "retention_devices",
    "cta",
    "duration_seconds",
    "adaptation_notes",
    "originality_notes"
  ],
  "properties": {
    "reference_id": { "type": "string", "minLength": 1 },
    "content_type": { "type": "string", "minLength": 1 },
    "ugc_template": { "type": "string", "minLength": 1 },
    "hook": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "mechanism": { "type": "string", "minLength": 1 },
    "product": { "type": ["string", "null"] },
    "core_benefit": { "type": ["string", "null"] },
    "scene_structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beat", "purpose", "action"],
        "properties": {
          "beat": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "duration_seconds": { "type": ["number", "null"], "exclusiveMinimum": 0 }
        }
      }
    },
    "dialogue": { "type": ["string", "null"] },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "camera": { "type": ["string", "null"] },
    "lighting": { "type": ["string", "null"] },
    "location": { "type": ["string", "null"] },
    "emotion": { "type": ["string", "null"] },
    "retention_devices": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cta": { "type": "string", "minLength": 1 },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "adaptation_notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "originality_notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
