{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_input.schema.json",
  "title": "VideoIngestionInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_type", "source"],
  "properties": {
    "source_type": { "enum": ["local", "url"] },
    "source": { "type": "string", "minLength": 1 },
    "filename": { "type": ["string", "null"], "minLength": 1 },
    "language": { "type": ["string", "null"], "minLength": 1 },
    "duration": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "platform": { "type": ["string", "null"], "minLength": 1 },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "source_type": { "const": "url" } }, "required": ["source_type"] },
      "then": { "properties": { "source": { "type": "string", "format": "uri", "pattern": "^https?://" } } }
    }
  ]
}
